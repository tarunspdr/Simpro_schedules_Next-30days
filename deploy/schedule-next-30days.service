[Unit]
Description=Simpro job schedules (next 30 days) -> SQL Server
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# deploy.sh fills in User and the /opt path.
# WorkingDirectory must contain the .env file and the venv/ directory.
User=YOUR_LINUX_USER
WorkingDirectory=/opt/schedule-next-30days
ExecStart=/opt/schedule-next-30days/venv/bin/python /opt/schedule-next-30days/main.py

# Capture stdout/stderr into the systemd journal — view with `journalctl -u ...`
StandardOutput=journal
StandardError=journal
SyslogIdentifier=schedule-next-30days

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only

# Don't restart automatically — the timer drives the schedule
Restart=no
TimeoutStartSec=30min
